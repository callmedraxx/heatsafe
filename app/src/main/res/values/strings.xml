    <string name="sick_stroke_title">Could be heat stroke. Get help now.</string>
    <string name="sick_stroke_1">Call %1$s, or get them to a clinic fast.</string>
    <string name="sick_stroke_2">Move them to shade, pour cool water over them and fan them.</string>
    <string name="sick_stroke_3">Cold wet cloths on the neck, armpits and groin.</string>
    <string name="sick_stroke_4">Give no drinks unless they\'re fully awake. Don\'t leave them alone.</string>
    <string name="sick_exh_title">Looks like heat exhaustion.</string>
    <string name="sick_exh_1">Lie down somewhere cool, legs raised.</string>
    <string name="sick_exh_2">Sip water or ORS.</string>
    <string name="sick_exh_3">Wet the skin, fan, loosen clothes.</string>
    <string name="sick_exh_4">Not better in an hour? Get medical help.</string>
    <string name="sick_none">If someone seems very unwell, don\'t wait. Call for help.</string>
    <string name="call_number">Call %1$s</string>
    <string name="sick_disclaimer">First aid, not a diagnosis.</string>

