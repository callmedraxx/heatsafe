    <!-- Cooling tips -->
    <string name="tip_shade">Move into the shade, or indoors, for a while.</string>
    <string name="tip_wet_face">Wet your face, neck and wrists with cool water.</string>
    <string name="tip_damp_cloth">Put a damp cloth on the back of your neck. Swap it when it gets warm.</string>
    <string name="tip_cool_wash">Take a cool shower or bucket wash, or soak your feet.</string>
    <string name="tip_wet_skin">It\'s very hot and dry: fans won\'t help on dry skin. Wet your skin first, then sit by the fan.</string>

