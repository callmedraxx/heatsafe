    <!-- Advice per level -->
    <string name="adv_safe_1">Heat is not a risk right now.</string>
    <string name="adv_safe_2">Drink when you\'re thirsty.</string>
    <string name="adv_caution_1">A cup of water every 45 minutes, before you\'re thirsty.</string>
    <string name="adv_caution_2">Rest in the shade. Wear loose, light-coloured clothes.</string>
    <string name="adv_ec_1">A cup every 30 minutes. Stay in the shade at midday.</string>
    <string name="adv_ec_2">Wet your face, neck and wrists every hour.</string>
    <string name="adv_ec_3">Check on older neighbours and anyone alone.</string>
    <string name="adv_danger_1">Stay indoors or in deep shade in the hottest hours.</string>
    <string name="adv_danger_2">A cup every 20 minutes. No more than 4 an hour.</string>
    <string name="adv_danger_3">Never leave a child or animal in a car or closed room.</string>
    <string name="adv_xd_1">Stop hard work outside. Heat stroke can strike at rest.</string>
    <string name="adv_xd_2">A cup every 15 minutes. Wet your skin, then sit by a fan.</string>
    <string name="adv_xd_3">Call or visit anyone old, sick or alone, morning and night.</string>
    <string name="adv_workrest">Each hour: %1$d min work, %2$d min rest in shade.</string>
    <string name="adv_dry_fans">Too hot and dry for a fan alone. Wet your skin first.</string>
    <string name="adv_powercut">Power out? Hang a wet cloth in the window and rest in the coolest room.</string>

